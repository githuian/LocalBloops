<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Off on purpose: WPF + WinForms global usings collide (Application, Brush, Color, ...). -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LocalBloops</RootNamespace>
    <AssemblyName>LocalBloops</AssemblyName>
    <StartupObject>LocalBloops.Program</StartupObject>
    <Version>0.2.3</Version>
    <!-- Generated by tools\make-icon.ps1 (same design as the tray icon). -->
    <ApplicationIcon>Assets\LocalBloops.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\LocalBloops.ico" />
    <!-- iRacing → Garage 61 track/car IDs, generated by tools\make-garage61-map.ps1. -->
    <EmbeddedResource Include="Assets\Garage61Map.json" LogicalName="LocalBloops.Garage61Map.json" />
  </ItemGroup>

</Project>
