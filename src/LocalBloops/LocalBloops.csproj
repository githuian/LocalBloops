<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Off on purpose: WPF + WinForms global usings collide (Application, Brush, Color, ...). -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LocalBloops</RootNamespace>
    <AssemblyName>LocalBloops</AssemblyName>
    <StartupObject>LocalBloops.Program</StartupObject>
    <Version>0.2.0</Version>
  </PropertyGroup>

</Project>
